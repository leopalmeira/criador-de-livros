# BOOKINTEL PRO — Configurações de Ambiente (.env.example)

# OpenRouter (Motor Principal de Texto Editorial: Free, Llama 3.3, Qwen, etc.)
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=

# Google Gemini (Fallback de Contingência / 1M tokens)
GEMINI_API_KEY=

# Replicate (FLUX.1 Schnell Imagens + LLaMA 3 70B Textos)
REPLICATE_API_TOKEN=
VITE_REPLICATE_API_TOKEN=

# Autenticação Backend Gemini (Chromium Privado para Geração de Capas)
GEMINI_LOGIN_EMAIL=
GEMINI_LOGIN_PASSWORD=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Groq (Llama 3.3 70B em alta velocidade)
GROQ_API_KEY=

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# DeepSeek (DeepSeek V3 / R1)
DEEPSEEK_API_KEY=

# Ollama Local (100% privado e gratuito na sua máquina)
OLLAMA_URL=http://localhost:11434

# Audiobook Studio — TTS Neural & Efeitos Sonoros
# Servidor local Kokoro TTS (se disponível: ex. http://localhost:8880/v1)
KOKORO_API_URL=
# Fish Audio (back-end only): nunca expor ao navegador
FISH_API_KEY=
# IDs dos modelos de voz Fish Audio (configure ambos para respeitar gênero)
FISH_VOICE_ID_MALE=
FISH_VOICE_ID_FEMALE=
# Opcional: um único ID de voz para ambos os gêneros
FISH_VOICE_ID=
# Modelo Fish Audio (s2.1-pro-free está disponível para testes)
FISH_MODEL=s2.1-pro-free
# Chave Freesound.org API para busca e download de efeitos sonoros CC0
FREESOUND_API_KEY=

# Configurações do Servidor Bridge Opcional
PORT=8000
HOST=127.0.0.1
