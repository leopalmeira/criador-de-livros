# BOOKINTEL PRO — Configurações de Ambiente (.env.example)

# OpenRouter (Motor Principal de Texto Editorial: Free, Llama 3.3, Qwen, etc.)
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=

# Google Gemini (Fallback de Contingência / 1M tokens)
GEMINI_API_KEY=

# Replicate (FLUX.1 Schnell Imagens + LLaMA 3 70B Textos)
REPLICATE_API_TOKEN=
VITE_REPLICATE_API_TOKEN=

# Autenticação Backend Gemini (Chromium Privado para Geração de Capas)
GEMINI_LOGIN_EMAIL=
GEMINI_LOGIN_PASSWORD=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Groq (Llama 3.3 70B em alta velocidade)
GROQ_API_KEY=

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# DeepSeek (DeepSeek V3 / R1)
DEEPSEEK_API_KEY=

# Ollama Local (100% privado e gratuito na sua máquina)
OLLAMA_URL=http://localhost:11434

# Configurações do Servidor Bridge Opcional
PORT=8000
HOST=127.0.0.1
