# BOOKINTEL PRO — Configurações de Ambiente (.env.example)

# Google Gemini (Recomendado para livros longos / 1M tokens)
GEMINI_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Groq (Llama 3.3 70B em alta velocidade)
GROQ_API_KEY=

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# DeepSeek (DeepSeek V3 / R1)
DEEPSEEK_API_KEY=

# Ollama Local (100% privado e gratuito na sua máquina)
OLLAMA_URL=http://localhost:11434

# Configurações do Servidor Bridge Opcional
PORT=8000
HOST=127.0.0.1
